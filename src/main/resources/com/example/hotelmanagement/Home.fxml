<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.control.Label?>
<?import javafx.geometry.Pos?>

<VBox xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.hotelmanagement.Controllers.HomeController"
      alignment="TOP_CENTER"
      spacing="20"
      style="-fx-padding: 30;">

   <children>

      <!-- Greeting + date -->
      <VBox alignment="CENTER_LEFT" spacing="5" prefWidth="600">
         <children>
            <!-- Dynamic greeting -->
            <Label fx:id="lblGreeting"
                   text="Welcome, User to Hotel Management Database"
                   style="-fx-font-size: 22; -fx-font-weight: bold;" />

            <!-- Date (set from controller) -->
            <Label fx:id="lblDate"
                   text="Today: "
                   style="-fx-font-size: 14; -fx-text-fill: #666666;" />
         </children>
      </VBox>

      <!-- Optional section title -->
      <Label text="Today’s Summary"
             style="-fx-font-size: 16; -fx-font-weight: bold;" />

      <!-- Summary card -->
      <HBox alignment="CENTER" prefWidth="600">
         <children>
            <GridPane hgap="40" vgap="15"
                      style="-fx-background-color: #f5f5f5;
                             -fx-padding: 20;
                             -fx-border-color: #dddddd;
                             -fx-border-radius: 10;
                             -fx-background-radius: 10;">
               <children>
                  <!-- Row 0: Total customers -->
                  <Label text="Total Customers:"
                         style="-fx-font-size: 14; -fx-font-weight: bold;"
                         GridPane.rowIndex="0" GridPane.columnIndex="0" />
                  <Label fx:id="lblTotalCustomers"
                         text="0"
                         style="-fx-font-size: 16;"
                         GridPane.rowIndex="0" GridPane.columnIndex="1" />

                  <!-- Row 1: Total reservations -->
                  <Label text="Total Reservations:"
                         style="-fx-font-size: 14; -fx-font-weight: bold;"
                         GridPane.rowIndex="1" GridPane.columnIndex="0" />
                  <Label fx:id="lblTotalReservations"
                         text="0"
                         style="-fx-font-size: 16;"
                         GridPane.rowIndex="1" GridPane.columnIndex="1" />
               </children>
            </GridPane>
         </children>
      </HBox>

   </children>
</VBox>
