<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.geometry.Pos?>

<VBox xmlns="http://javafx.com/javafx/23.0.1"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.hotelmanagement.Controllers.HomeController"
      alignment="TOP_CENTER"
      spacing="20"
      style="-fx-padding: 30;">

   <children>

      <!-- Top bar: title + logout -->
      <HBox alignment="CENTER_RIGHT" spacing="10" prefWidth="600">
         <children>
            <Label text="UOG G5 Hotel Management" style="-fx-font-size: 20; -fx-font-weight: bold;" />
            <HBox HBox.hgrow="ALWAYS" />
            <Button fx:id="btnLogout"
                    text="Logout"
                    onAction="#onLogout" />
         </children>
      </HBox>

      <!-- Today label -->
      <Label fx:id="lblDate"
             style="-fx-font-size: 14;" />

      <!-- Summary stats -->
      <HBox alignment="CENTER" spacing="40">
         <children>

            <VBox alignment="CENTER" spacing="5">
               <children>
                  <Label text="Total Customers"
                         style="-fx-font-size: 14; -fx-font-weight: bold;" />
                  <Label fx:id="lblTotalCustomers"
                         style="-fx-font-size: 16;" />
               </children>
            </VBox>

            <VBox alignment="CENTER" spacing="5">
               <children>
                  <Label text="Total Reservations"
                         style="-fx-font-size: 14; -fx-font-weight: bold;" />
                  <Label fx:id="lblTotalReservations"
                         style="-fx-font-size: 16;" />
               </children>
            </VBox>

         </children>
      </HBox>

   </children>
</VBox>
